{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai_compatible": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenAI Compatible (local)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "gemma-4-26b-a4b-it-heretic-guff": {
          "name": "Gemma 4 26B Abliterated It Heretic",
          "limit": {
            "context": 65536,
            "output": 32768
          }
        }
      }
    },
    "openai_compatible_embedding": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenAI Compatible Embedding (local)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {}
    }
  },
  "model": "openai_compatible/gemma-4-26b-a4b-it-heretic-guff",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "python *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "rm *": "deny"
    }
  },
  "plugin": [
    ".opencode/plugins/story-compaction.ts"
  ],
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "story-orchestrator": {
      "model": "openai_compatible/gemma-4-26b-a4b-it-heretic-guff"
    },
    "chapter-writer": {
      "model": "openai_compatible/gemma-4-26b-a4b-it-heretic-guff"
    },
    "outline-planner": {
      "model": "openai_compatible/gemma-4-26b-a4b-it-heretic-guff"
    },
    "wiki-maintainer": {
      "model": "openai_compatible/gemma-4-26b-a4b-it-heretic-guff"
    }
  }
}
