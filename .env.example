# Supported local providers do not require cloud API keys.

# LLM API base URL for tool scripts and all Python backend paths that have no
# explicit config.yml override (infrastructure.model_api_base takes precedence).
# Default assumes LM Studio on its standard port. Any OpenAI-compatible endpoint
# works — e.g. Ollama (http://localhost:11434/v1), llama.cpp, or a remote host.
LLM_API_BASE=http://127.0.0.1:1234/v1

# Default model identifier used by tool scripts.
LLM_MODEL=your-model-name-here
