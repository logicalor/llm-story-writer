Screen {
    layout: grid;
    grid-size: 1;
}

#main-grid {
    layout: horizontal;
    height: 1fr;
}

#phase-panel {
    width: 24;
    border: solid $primary;
    padding: 1;
}

#phase-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

#phase-list {
    height: auto;
}

.phase-item {
    height: 1;
}

.phase-pending {
    color: $text-muted;
}

.phase-active {
    color: $warning;
    text-style: bold;
}

.phase-done {
    color: $success;
}

.phase-awaiting {
    color: $accent;
    text-style: bold;
}

.phase-error {
    color: $error;
    text-style: bold;
}

#output-log {
    width: 1fr;
    border: solid $accent;
    padding: 0 1;
}

#wiki-panel {
    width: 60;
    border: solid $success;
    padding: 1;
    display: none;
}

#wiki-title {
    text-style: bold;
    color: $success;
    margin-bottom: 1;
}

#wiki-log {
    height: 1fr;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: $surface;
    color: $text;
    padding: 0 1;
}

#approval-input {
    dock: bottom;
    height: 3;
    border: solid $warning;
    margin: 0 1;
}
